import random

words = ["ladle", "keys", "garbage"]

# makes the word with the guessed letters showing and the unguessed letters hidden
def build_display(single_word, guessed_letters):
    displayed_word = ""
    for letter in single_word:
        if letter in guessed_letters:
            displayed_word += letter
        else:
            displayed_word += "_"
    return " ".join(displayed_word)

# keeps prompting until the user guesses a letter, or types in help or "guess answer"
def get_guess(guessed_letters):
    while True:
        user_input = input("Guess a letter: ").strip().lower()
 
        if user_input == "guess answer":
            return user_input
        
    # makes help not use a turn
        if user_input == "help":
            if guessed_letters:
                print("Letters used so far: " + ", ".join(sorted(guessed_letters)))
            else:
                print("No letters guessed yet.")
            continue
 
        if len(user_input) == 1 and user_input.isalpha():
            return user_input
 
        print("Not a valid guess. Please enter a single letter.")

def play_game():
    single_word = random.choice(words)
    lives = 6
    guessed_letters = set()
 
    while lives > 0:
        displayed_word = build_display(single_word, guessed_letters)
        print(displayed_word)
 
        # if no underscores are left then the word has been guessed and the game is over
        if "_" not in displayed_word:
            print("Word guessed, you've won!")
            return
 
        print("Lives left: " + str(lives))
        user_input = get_guess(guessed_letters)

 if user_input == "guess answer":
            full_guess = input("Enter the full word: ").strip().lower()
            if full_guess == single_word:
                print(" ".join(single_word))
                print("Word guessed, you've won!")
            else:
                print("Out of lives, game over!")
            return
 
        # makes a repeated letter not cost any lives
        if user_input in guessed_letters:
            print("You already guessed that letter.")
            continue
 
        guessed_letters.add(user_input)
 
        if user_input not in single_word:
            lives -= 1
            print("Letter not found!")

    #lives reaches zero
    print(build_display(single_word, guessed_letters))
    print("Out of lives, game over!")

def ask_play_again():
    user_input = input("Play again? (yes/no) ").strip().lower()
    while user_input != "yes" and user_input != "no":
        user_input = input("Invalid input. Play again? (yes/no) ").strip().lower()
    return user_input == "yes"
 
 
print("Let's play hangman!")
 
while True:
    play_game()
    if not ask_play_again():
        break
    print("New game")
