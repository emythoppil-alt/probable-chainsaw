import random
print("Let's play hangman!")
user_input = input("Enter a letter: ")
words = ["laddle", "keys", "garbage"]
single_word = random.choice(words)
lives = 6

print("The word has " + str(len(single_word)) + " letters.")

for i in range(len(single_word)):
    print("_", end="")


while len(user_input) > 1 or len(user_input) == 0 or not user_input.isalpha():
    print("Not a valid guess. Please enter a single letter.")
    user_input = input("Enter a letter: ")

if user_input in single_word:
    print("You guessed a letter correctly!")
    print("You have " + str(lives) + " lives left.")

print()
user_input = user_input.lower()
guessed_letters = {user_input}

if user_input not in single_word:
    lives -= 1
    print("That letter is not in the word.")

while lives > 0:
    displayed_word = ""
    for letter in single_word:
        if letter in guessed_letters:
            displayed_word += letter
        else:
            displayed_word += "_"

    print("\nWord: " + " ".join(displayed_word))

    if "_" not in displayed_word:
        print("You guessed the word! You win!")
        break

    print("You have " + str(lives) + " lives left.")
    user_input = input("Enter a letter: ").strip().lower()

    while len(user_input) != 1 or not user_input.isalpha():
        print("Not a valid guess. Please enter a single letter.")
        user_input = input("Enter a letter: ").strip().lower()

    if user_input in guessed_letters:
        print("You already guessed that letter.")
        continue

    guessed_letters.add(user_input)

    if user_input in single_word:
        print("You guessed a letter correctly!")
    else:
        lives -= 1
        print("That letter is not in the word.")

if lives == 0:
    print("\nYou ran out of lives. The word was " + single_word + ".")
